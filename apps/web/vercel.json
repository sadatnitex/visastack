{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "crons": [
    {
      "path": "/api/jobs/process-intake",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/jobs/process-deletions",
      "schedule": "10 3 * * *"
    },
    {
      "path": "/api/jobs/process-erasure",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/jobs/process-abandoned-uploads",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/jobs/process-notifications",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/process-notification-sweeps",
      "schedule": "0 * * * *"
    }
  ]
}
