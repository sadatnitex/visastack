{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "crons": [
    {
      "path": "/api/jobs/process-intake",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/jobs/process-deletions",
      "schedule": "10 3 * * *"
    },
    {
      "path": "/api/jobs/process-erasure",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/jobs/process-abandoned-uploads",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/jobs/process-notifications",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/jobs/process-notification-sweeps",
      "schedule": "50 3 * * *"
    },
    {
      "path": "/api/jobs/process-downgrades",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/jobs/process-abandoned-invitations",
      "schedule": "10 4 * * *"
    },
    {
      "path": "/api/jobs/process-case-retention-notices",
      "schedule": "20 4 * * *"
    },
    {
      "path": "/api/jobs/process-case-retention-purge",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/jobs/process-inactive-account-notices",
      "schedule": "40 4 * * *"
    },
    {
      "path": "/api/jobs/process-inactive-account-deletions",
      "schedule": "50 4 * * *"
    },
    {
      "path": "/api/jobs/process-account-exports",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/jobs/process-account-export-expiry",
      "schedule": "10 5 * * *"
    },
    {
      "path": "/api/jobs/process-legal-hold-reminders",
      "schedule": "20 5 * * *"
    },
    {
      "path": "/api/jobs/process-rate-limit-prune",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/jobs/process-payment-reconciliation",
      "schedule": "40 5 * * *"
    },
    {
      "path": "/api/jobs/process-database-backup",
      "schedule": "0 7 * * 0"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
