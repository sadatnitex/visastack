# VisaStack — environment variable contract.
# Copy to `.env.local` for local dev, or set in Vercel Project Settings for deploys.
# NEVER commit real secrets. This file documents the KEYS only.

# --- Runtime ---
NODE_ENV=development

# --- Deployment mode override (master directive §3) ---
# One of: development | controlled_pilot | commercial. Optional — when unset,
# the mode is derived from VERCEL_ENV (production -> controlled_pilot; else
# development). Set this explicitly only for a deliberate mode change (e.g.
# the eventual, gated commercial activation) — never to bypass the
# commercial-readiness guard.
DEPLOYMENT_MODE=

# --- Provider registry (master directive §7 "PR 11" commercial activation
# framework). Every var below is OPTIONAL — unset means "use the pilot
# default," which is what every var currently resolves to. Setting one to a
# value this deployment doesn't implement fails loudly at startup/readiness
# (apps/web/src/lib/providers.ts) rather than silently ignoring it. None of
# these alone perform commercial activation — DEPLOYMENT_MODE=commercial plus
# the commercial readiness guard's other gates (see
# docs/operations/pilot-to-commercial-activation.md) do that. ---
IDENTITY_PROVIDER=
STORAGE_PROVIDER=
DATABASE_PROVIDER=
MALWARE_SCANNER_PROVIDER=
DOCUMENT_CONVERTER_PROVIDER=
JOB_PROVIDER=
EMAIL_PROVIDER=
OBSERVABILITY_PROVIDER=
PAYMENT_PROVIDER=

# --- Identity: WorkOS AuthKit ---
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=

# --- Platform administration: one-time bootstrap only (master directive §7 "PR 5") ---
# Comma-separated email allowlist. Authority ONLY while `platform_roles` has
# never had a single grant — the first platform owner uses it to grant real,
# auditable, revocable roles (including their own); every grant after that is
# read from the database, and this list is never consulted again even if it
# stays configured. Never treat this as an ongoing admin allowlist.
ADMIN_EMAILS=

# --- Step-up / reauthentication assurance (master directive §7 "PR 5") ---
# HMAC secret signing the short-lived, action-bound step-up assurance token
# issued after a genuine WorkOS reauthentication (apps/web/src/lib/step-up.ts).
# Required wherever a step-up-gated action (e.g. agency bulk export) is used.
STEP_UP_SIGNING_SECRET=

# --- Database: Neon Postgres ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Document Vault: signed access references (required) ---
# HMAC secret used to sign every short-lived blob-access reference — required
# regardless of which storage backend below is active.
BLOB_SIGNING_SECRET=

# --- Object storage: Vercel Private Blob (Release B — pilot/commercial track) ---
# Present -> VercelPrivateBlobStorage is the active backend (real private
# access; bytes served only through the app's own signed route).
# Absent -> falls back to Neon-bytea storage, which is REDUCED-CONTROL and
# NON-COMMERCIAL (tests/local dev/legacy only — master directive §10/§21E).
BLOB_READ_WRITE_TOKEN=

# --- Upload quotas (optional overrides, in MB; conservative pilot defaults
# apply when unset — master directive §10) ---
QUOTA_MAX_UPLOAD_MB=
QUOTA_MAX_APPLICANT_EVIDENCE_MB=
QUOTA_MAX_ACCOUNT_EVIDENCE_MB=
QUOTA_PLATFORM_WARNING_MB=
QUOTA_PLATFORM_HARD_STOP_MB=

# --- Optional future object storage: a private S3-compatible provider ---
# Not required for first commercial release if Vercel Private Blob satisfies
# the approved private-access/retention/regional requirements (master
# directive §5/§21E). Kept here only as a documented future migration path.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_QUARANTINE=
STORAGE_BUCKET_CLEAN=

# --- Durable pipeline (Release B — low-volume async intake) ---
# Intake processing runs as a DB-backed job queue (master directive §5: "not
# approved now" list includes paid Inngest — no external queue is used).
# CRON_SECRET authorizes the periodic sweep at /api/jobs/process-intake
# (Vercel signs cron-triggered requests with this as a Bearer token when it's
# set on the project). The route fails closed (503) if unset.
CRON_SECRET=

# --- AI Gateway (Release D — OpenAI adapter). Cost/attempt/page caps below
# are conservative pilot defaults (like the quotas above) when left blank —
# never unlimited. ---
AI_ENABLED=
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_MODEL_PRIMARY=
OPENAI_REASONING_EFFORT=
OPENAI_STORE_RESPONSES=
AI_PILOT_MONTHLY_HARD_LIMIT_USD=
AI_PILOT_MONTHLY_WARNING_USD=
AI_PER_DOCUMENT_LIMIT_USD=
AI_MAX_ATTEMPTS=
AI_MAX_PAGES_PER_DOCUMENT=

# --- Observability: Sentry (Phase 6) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Commercial readiness guard attestations (master directive §7 "PR 11").
# Commercial mode (DEPLOYMENT_MODE=commercial) fails readiness (503) unless
# every gate the directive names is true — apps/web/src/lib/commercial-
# readiness.ts. Most gates are checked live from config above; the ones below
# are operational facts no server-side check can verify by itself, so each
# requires an explicit, deliberate =true here. Leaving one unset means "not
# attested" — never silently satisfied. Setting one true is a claim that the
# named work has genuinely been done; see
# docs/operations/pilot-to-commercial-activation.md before setting any of
# these. There is no flag for "real malware scanner" — that gate cannot be
# attested past; it requires a real adapter to be built. ---
COMMERCIAL_READINESS_ATTEST_WORKOS_PRODUCTION=
COMMERCIAL_READINESS_ATTEST_EXTERNAL_DELETION_VERIFIED=
COMMERCIAL_READINESS_ATTEST_TENANT_ISOLATION_SUITE=
COMMERCIAL_READINESS_ATTEST_PERMISSION_MATRIX=
COMMERCIAL_READINESS_ATTEST_PRIVACY_CONSENT_CONFIG=
COMMERCIAL_READINESS_ATTEST_BACKUP_RESTORE_VERIFIED=
COMMERCIAL_READINESS_ATTEST_PRODUCTION_E2E=
COMMERCIAL_READINESS_ATTEST_INCIDENT_OWNER=
COMMERCIAL_READINESS_ATTEST_TERMS_AND_PRIVACY_NOTICE=
COMMERCIAL_READINESS_ATTEST_NO_CRITICAL_HIGH_FINDINGS=
COMMERCIAL_READINESS_ATTEST_EXTERNAL_PENTEST=
