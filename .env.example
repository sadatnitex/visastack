# VisaStack — environment variable contract (Phase 0 baseline).
# Copy to `.env.local` for local dev, or set in Vercel Project Settings for deploys.
# NEVER commit real secrets. This file documents the KEYS only.

# --- Runtime ---
NODE_ENV=development

# --- Identity: WorkOS AuthKit (Phase 1) ---
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=

# --- Database: Neon Postgres (Phase 1) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Object storage: R2 / S3 (Phase 3) ---
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_QUARANTINE=
STORAGE_BUCKET_CLEAN=

# --- Durable pipeline: Inngest (Phase 3) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- AI Gateway (Phase 4) ---
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=

# --- Observability: Sentry (Phase 6) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
