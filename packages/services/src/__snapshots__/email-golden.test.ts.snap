exports[`email golden > AGENCY_ACCESS_ENDING: text and html 1`] = `
{
  "html": "<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>Access to a client is about to end</title>
</head>
<body style="margin:0;padding:0;background:#f7f9fe;-webkit-text-size-adjust:100%;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#f7f9fe;">The one fact this notice carries.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f7f9fe;">
<tr><td align="center" style="padding:32px 16px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
<tr><td style="background:#13243d;border-radius:16px 16px 0 0;padding:20px 28px;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
<td style="padding-right:10px;vertical-align:middle;"><img src="https://vs.example.test/icons/icon-192.png" width="28" height="28" alt="" style="display:block;border:0;border-radius:6px;"></td>
<td style="vertical-align:middle;font-size:17px;font-weight:700;letter-spacing:-0.01em;color:#ffffff;">VisaStack</td>
</tr></table>
</td></tr>
<tr><td style="background:#ffffff;border:1px solid #e4e9f1;border-top:0;border-radius:0 0 16px 16px;padding:32px 28px 28px;">
<p style="margin:0 0 10px;font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#1d4c98;">Your Agency</p>
<h1 style="margin:0 0 16px;font-size:24px;line-height:1.25;font-weight:700;letter-spacing:-0.02em;color:#13243d;">Access to a client is about to end</h1>
<p style="margin:0 0 12px;font-size:16px;line-height:1.55;color:#13243d;">The one fact this notice carries.</p>

<p style="margin:0 0 24px;font-size:15px;line-height:1.55;color:#516174;">After that date you cannot open the case.</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
<td style="border-radius:980px;background:#1d4c98;">
<a href="https://vs.example.test" style="display:inline-block;padding:13px 26px;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:980px;">Open the Case</a>
</td></tr></table>

<p style="margin:24px 0 0;font-size:12px;line-height:1.5;color:#596879;">If the button does not open, copy this address into your browser:<br><a href="https://vs.example.test" style="color:#1d4c98;word-break:break-all;">https://vs.example.test</a></p>
</td></tr>
<tr><td style="padding:20px 28px 0;">
<p style="margin:0 0 6px;font-size:12px;line-height:1.55;color:#596879;">VisaStack keeps one visa record you reuse for every application. You decide what is shared, with whom and for how long.</p>
<p style="margin:0;font-size:12px;line-height:1.55;color:#596879;">This email was sent to person@example.test.</p>

</td></tr>
</table>
</td></tr>
</table>
</body>
</html>",
  "text": "Access to a client is about to end

The one fact this notice carries.

After that date you cannot open the case.

Open the Case: https://vs.example.test

-- 
VisaStack
VisaStack keeps one visa record you reuse for every application. You decide what is shared, with whom and for how long.
This email was sent to person@example.test.",
}
`;

