{
  "name": "@visastack/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Concrete storage/scanning/conversion adapters: Neon-bytea blob storage (dev/test), Vercel Private Blob (pilot), and a built-in structural safety scanner (StoragePort/BlobStore/MalwareScannerPort/DocumentConverterPort).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "eval": "tsx src/eval/run.ts",
    "backfill:protected-fields": "tsx src/backfill-protected-fields.ts",
    "reconcile:restored-branch": "tsx src/reconcile-restored-branch.ts",
    "verify:audit-chain": "tsx src/verify-audit-chain.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/lib-storage": "^3.1149.0",
    "@napi-rs/canvas": "^1.0.9",
    "@vercel/blob": "^2.6.1",
    "@visastack/core": "workspace:*",
    "@visastack/db": "workspace:*",
    "@visastack/services": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "mammoth": "^1.12.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.13",
    "@types/node": "^22.10.2",
    "jszip": "^3.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
