{
  "name": "@visastack/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Canonical persistence layer — Drizzle schema and migrations (Neon Postgres).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:repair-migration-tracking": "tsx src/repair-migration-tracking.ts",
    "db:diagnose": "tsx src/diagnose-db.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@visastack/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.13",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
