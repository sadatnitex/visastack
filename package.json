{
  "name": "visastack",
  "version": "0.0.0",
  "private": true,
  "description": "VisaStack \u2014 universal, pack-composable visa/immigration platform.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm run test:node",
    "test:node": "node --test \"scripts/*.test.mjs\" \"scripts/country-packs/*.test.mjs\" \"scripts/programme/*.test.mjs\" \"infra/**/*.test.mjs\"",
    "lint": "biome check . && node scripts/check-flat-design.mjs && node scripts/check-route-navigation.mjs && node scripts/ui-ratchet.mjs",
    "scan:supply-chain": "node scripts/supply-chain/scan.mjs",
    "test:supply-chain": "node --test scripts/supply-chain/checks.test.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "scan:flat-ui": "node scripts/check-flat-design.mjs",
    "scan:ui-ratchet": "node scripts/ui-ratchet.mjs",
    "ui:baseline": "node scripts/ui-baseline/capture.mjs",
    "ui:compare": "node scripts/ui-baseline/compare.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "postcss": "8.5.26",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.5 <1.0.0",
      "postcss": ">=8.5.23 <9.0.0",
      "nanoid": ">=3.3.17 <4.0.0",
      "undici": ">=6.29.1 <7.0.0",
      "zod@>=4 <4.6.6": ">=4.6.6 <5",
      "@xmldom/xmldom": ">=0.8.15 <0.9.0",
      "source-map-js": ">=1.2.2 <2.0.0",
      "vite": ">=6.4.3 <7.0.0",
      "@neondatabase/auth-ui": "-"
    }
  }
}
